/* 汇总卡 */
.sum-card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.sum-head {
  margin-bottom: 28rpx;
}

.sum-money .money-num {
  font-size: 52rpx;
  letter-spacing: -1.4rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: var(--pine);
  color: #f7f5f0;
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 0.8rpx;
  box-shadow: 0 16rpx 30rpx -18rpx rgba(36, 53, 46, 0.9);
}

.add-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.add-plus {
  margin-right: 8rpx;
  font-size: 28rpx;
  opacity: 0.85;
}

/* 环形图 */
.ring-wrap {
  display: flex;
  align-items: center;
  padding: 6rpx 0 2rpx;
}

.ring-chart {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-cny {
  font-size: 18rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.ring-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
}

.ring-legend {
  flex: 1;
  min-width: 0;
  margin-left: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 7rpx 0;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 5rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.legend-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-pct {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-left: 12rpx;
}

/* ---------------- 账单行 ---------------- */
.bill {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.bill:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

/* 类别首字色块：比整行染色克制，又能快速扫读 */
.bill-tile {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.bill-tile.is-in {
  background: var(--in-soft);
  color: var(--in);
}

.bill-tile.is-out {
  background: var(--out-soft);
  color: var(--out);
}

.bill-body {
  flex: 1;
  min-width: 0;
}

.bill-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.bill-cat {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.bill-amt {
  margin-left: 20rpx;
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
}

.bill-amt.is-in {
  color: var(--in);
}

.bill-amt.is-out {
  color: var(--out);
}

.bill-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bill-foot {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.bill-date {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-right: 14rpx;
}

.bill-remark {
  margin-top: 10rpx;
  padding-left: 14rpx;
  border-left: 3rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ---------------- 记一笔面板 ---------------- */
.type-switch {
  display: flex;
  padding: 6rpx;
  background: #efece5;
  border-radius: 22rpx;
  margin: 16rpx 0 8rpx;
}

.type-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-2);
  border-radius: 18rpx;
  transition: all 0.2s ease;
}

.type-item.is-out {
  background: var(--out-soft);
  color: var(--out);
  font-weight: 600;
}

.type-item.is-in {
  background: var(--in-soft);
  color: var(--in);
  font-weight: 600;
}

/* 金额是面板里最重要的输入，字号加大 */
.amount-input {
  font-size: 42rpx !important;
  font-weight: 600;
  letter-spacing: -0.6rpx;
}

.field-tip {
  padding: 8rpx 4rpx 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: right;
}

.voucher-row {
  align-items: flex-start;
}

.voucher-pick {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.voucher-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--soft-2);
}

.voucher-empty {
  width: 168rpx;
  height: 112rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #ded9cf;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--soft);
}

.voucher-plus {
  font-size: 28rpx;
  color: var(--ink-3);
  line-height: 1.1;
}

.voucher-hint {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.voucher-del {
  font-size: 21rpx;
  color: var(--out);
  margin-top: 10rpx;
}

.ph {
  color: #bcb9b1;
}
